{
  "compilerOptions": {
    /* === Path Aliases === */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/context/*": ["./context/*"],
      "@/components/*": ["./components/*"],
      "@/utils/*": ["./utils/*"]
    },

    /* === Module & Target === */
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",

    /* === JSX & React === */
    "jsx": "preserve",
    "types": ["node", "react", "react-dom", "next", "next/types/global"],

    /* === Libraries === */
    "lib": ["dom", "dom.iterable", "esnext"],

    /* === Strictness & Safety === */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "esModuleInterop": true,

    /* === File Handling === */
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "incremental": true,

    /* === Next.js Plugin === */
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "context/**/*",
    "utils/**/*",
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "global.d.ts"
  ],
  "exclude": ["node_modules", ".next"]
}